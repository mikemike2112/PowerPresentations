<Window x:Class="PowerPresentations.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:app="clr-namespace:PowerPresentations.App"
        Title="PowerPresentations" Width="1360" Height="840" MinWidth="980" MinHeight="600"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}" Icon="icon.ico"
        AllowDrop="True" FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="Root" Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- barra del titolo personalizzata -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" x:Name="QuickBar" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" FontSize="13"/>
            <Border Grid.Column="2" Width="460" Height="30" CornerRadius="6" Background="{DynamicResource RibbonBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <ContentControl x:Name="SearchIcon" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="Search" Margin="32,0,4,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"
                             AutomationProperties.Name="Cerca" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey" GotFocus="OnSearchFocus"/>
                    <TextBlock x:Name="SearchHint" Text="Cerca" Margin="36,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=Search}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Width="460">
                        <Border Background="{DynamicResource RibbonBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="4" MaxHeight="360">
                            <ListBox x:Name="SearchList" Background="Transparent" BorderThickness="0" PreviewMouseLeftButtonUp="OnSearchPick" Foreground="{DynamicResource FgBrush}"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True" x:Name="CaptionButtons"/>
        </Grid>

        <!-- schede + ribbon -->
        <TabControl x:Name="Ribbon" Grid.Row="1" Background="Transparent" SelectionChanged="OnRibbonTab"/>

        <!-- corpo -->
        <Grid Grid.Row="2" x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="NotesRow" Height="110"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="Thumbs" Grid.RowSpan="2" Background="Transparent" BorderThickness="0"
                     SelectionChanged="OnThumbSelected" AllowDrop="True" Drop="OnThumbDrop" DragOver="OnThumbDragOver"
                     PreviewMouseLeftButtonDown="OnThumbMouseDown" PreviewMouseMove="OnThumbMouseMove" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="OnThumbKey">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Top" Margin="2,2,0,0"/>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Opacity="{Binding Opacity}">
                                <Image Source="{Binding Image}" Stretch="Uniform" Width="{Binding Width}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid x:Name="EditArea" Grid.Column="1">
                <app:SlideView x:Name="View"/>
                <TextBox x:Name="Editor" Visibility="Collapsed" Background="White" Foreground="Black" CaretBrush="Black" AcceptsReturn="True" AcceptsTab="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                         BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" TextWrapping="Wrap" LostFocus="OnEditorLost" PreviewKeyDown="OnEditorKey"/>
            </Grid>

            <Grid x:Name="NotesArea" Grid.Column="1" Grid.Row="1" Background="Transparent">
                <TextBlock x:Name="NotesHint" Text="Fare clic per inserire le note" Margin="14,8" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" FontSize="14"/>
                <TextBox x:Name="Notes" Background="Transparent" BorderThickness="0,1,0,0" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,6" FontSize="14"
                         AutomationProperties.Name="Note del relatore" LostFocus="OnNotesLost" TextChanged="OnNotesChanged"/>
            </Grid>
        </Grid>

        <!-- barra di stato -->
        <Grid Grid.Row="3" Background="Transparent">
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="12,0" FontSize="12"/>
            <StackPanel x:Name="StatusRight" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0"/>
        </Grid>

        <!-- scheda File a tutta pagina -->
        <Grid x:Name="Backstage" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="{DynamicResource BgBrush}"/>
    </Grid>
</Window>
